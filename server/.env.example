[TEMPLATE]
# ============================================================
# CareFlow Environment Configuration
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB (required)
MONGO_URI=mongodb://localhost:27017/careflow

# ============================================================
# Gemini (REQUIRED for hackathon compliance)
# ============================================================
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# ============================================================
# Sarvam AI (REQUIRED for Vaidya multilingual support)
# ============================================================
# Get your key at: https://www.sarvam.ai/
# Used by Vaidya for: language detection, translation between
# patient language (Hindi/Marathi/etc.) and English for Gemini.
# Server-side only — never exposed to frontend.
SARVAM_API_KEY=

# ============================================================
# AI Provider Selection
# ============================================================
# "gemini" = Uses Gemini + Google ADK (production)
# "groq"   = Uses Groq (development fallback, NO hackathon compliance)
AI_PROVIDER=gemini

# Groq (development fallback only — NOT hackathon compliant)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ============================================================
# Agent Execution Mode
# ============================================================
# "local"  = Agent triggered synchronously (development)
# "pubsub" = Agent triggered via Google Cloud Pub/Sub (production)
AGENT_EXECUTION_MODE=local

# ============================================================
# Google Cloud (required for pubsub mode)
# ============================================================
GOOGLE_CLOUD_PROJECT=Careflow
GOOGLE_CLOUD_LOCATION=us-central1
